<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:services="using:AdbForwarder.Surface.Services"
             xmlns:vm="using:AdbForwarder.Surface.ViewModels"
             x:Class="AdbForwarder.Surface.Views.AdbForwarderView"
             x:DataType="vm:AdbForwarderViewModel">
  <UserControl.Styles>
    <Style Selector="Button.connection-mode">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.connection-mode:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushLayerAltBackground}" />
    </Style>
    <Style Selector="Button.connection-mode.selected">
      <Setter Property="Background" Value="{DynamicResource MptBrushNavigationSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <StackPanel IsVisible="{Binding IsForward}"
                Spacing="{DynamicResource MptSpacingM}"
                MaxWidth="1600"
                HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource MptSpacingM}">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="MptPageTitle" Text="ADB Forwarder" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="有线转发设备与 Wi-Fi ADB 设备状态" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource MptSpacingS}"
                    VerticalAlignment="Center">
          <Border Classes="MptStatusBadge"
                  Classes.running="{Binding ServiceIsActive}"
                  Classes.degraded="{Binding ServiceNeedsAttention}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ServiceStateLabel}" Classes="MptMeta" />
          </Border>
          <controls:MptButton Content="设置" Command="{Binding ShowSettingsCommand}" />
          <controls:MptButton Content="诊断" Command="{Binding ShowDiagnosticsCommand}" />
          <controls:MptButton Content="刷新" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>

      <Border Classes="MptInset" IsVisible="{Binding HasConfigurationError}">
        <StackPanel Spacing="4">
          <TextBlock Text="设备配置读取失败" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ConfigurationError}" Classes="MptMeta" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfigurationPath}" Classes="MptMono" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid x:Name="DeviceOverviewGrid"
            ColumnDefinitions="0.85*,1.15*"
            ColumnSpacing="12">
        <Border x:Name="ForwardDevicesCard"
                Classes="MptCard"
                Padding="0"
                VerticalAlignment="Top">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="16,14,16,10">
              <TextBlock Classes="MptSectionTitle" Text="有线转发设备" />
              <TextBlock Grid.Column="1"
                         Classes="MptMeta"
                         Text="{Binding ConfiguredForwardDevices.Count, StringFormat='共 {0} 台'}"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Background="{DynamicResource MptBrushSurfaceMuted}"
                    Margin="1,0,1,0"
                    Padding="14,8">
              <Grid ColumnDefinitions="1.55*,0.65*,0.85*,1.25*" ColumnSpacing="12">
                <TextBlock Classes="MptMeta" Text="ADB SERIAL" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="端口" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Classes="MptMeta" Text="状态" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Classes="MptMeta" Text="最后在线" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding ConfiguredForwardDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:AdbConfiguredForwardDevice">
                  <Border MinHeight="42"
                          Padding="14,7"
                          BorderBrush="{DynamicResource MptBrushDivider}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="1.55*,0.65*,0.85*,1.25*" ColumnSpacing="12">
                    <TextBlock Text="{Binding DeviceId}"
                               Classes="MptMono"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Port}"
                               Classes="MptMono"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="● 在线"
                                 Foreground="{DynamicResource MptBrushSuccess}"
                                 IsVisible="{Binding IsOnline}" />
                      <TextBlock Text="● 离线"
                                 Foreground="{DynamicResource MptBrushDanger}"
                                 IsVisible="{Binding IsOffline}" />
                      <TextBlock Text="● 已断开"
                                 Foreground="{DynamicResource MptBrushDanger}"
                                 IsVisible="{Binding IsDisconnected}" />
                    </Grid>
                    <TextBlock Grid.Column="3"
                               Text="{Binding LastSeenText}"
                               Classes="MptMono"
                               VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="MptEmptyState"
                    Margin="12"
                    IsVisible="{Binding !HasConfiguredForwardDevices}">
              <TextBlock Text="没有配置有线转发设备" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="WifiDevicesCard"
                Grid.Column="1"
                Classes="MptCard"
                Padding="0"
                VerticalAlignment="Top">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="16,14,16,10">
              <TextBlock Classes="MptSectionTitle" Text="Wi-Fi ADB 设备" />
              <TextBlock Grid.Column="1"
                         Classes="MptMeta"
                         Text="{Binding ConfiguredWifiDevices.Count, StringFormat='共 {0} 台'}"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Background="{DynamicResource MptBrushSurfaceMuted}"
                    Margin="1,0,1,0"
                    Padding="14,8">
              <Grid ColumnDefinitions="0.8*,1.05*,1.05*,0.85*,1.45*" ColumnSpacing="12">
                <TextBlock Classes="MptMeta" Text="名称" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="端点" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Classes="MptMeta" Text="USB SERIAL" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Classes="MptMeta" Text="状态" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Classes="MptMeta" Text="最后操作" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding ConfiguredWifiDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:AdbConfiguredWifiDevice">
                  <Border MinHeight="42"
                          Padding="14,7"
                          BorderBrush="{DynamicResource MptBrushDivider}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="0.8*,1.05*,1.05*,0.85*,1.45*" ColumnSpacing="12">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Endpoint}"
                               Classes="MptMono"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding UsbSerial}"
                               Classes="MptMono"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                      <TextBlock Text="● 在线"
                                 Foreground="{DynamicResource MptBrushSuccess}"
                                 IsVisible="{Binding IsHealthy}" />
                      <TextBlock Text="● 正在恢复"
                                 Foreground="{DynamicResource MptBrushWarning}"
                                 IsVisible="{Binding IsRecovering}" />
                      <TextBlock Text="● 需要恢复"
                                 Foreground="{DynamicResource MptBrushWarning}"
                                 IsVisible="{Binding NeedsRecovery}" />
                      <TextBlock Text="● 等待 USB"
                                 Foreground="{DynamicResource MptBrushDanger}"
                                 IsVisible="{Binding HasError}" />
                      <TextBlock Text="○ 已停用"
                                 Foreground="{DynamicResource MptBrushTextMuted}"
                                 IsVisible="{Binding IsDisabled}" />
                    </Grid>
                    <TextBlock Grid.Column="4"
                               Text="{Binding LastAction}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="MptEmptyState"
                    Margin="12"
                    IsVisible="{Binding !HasConfiguredWifiDevices}">
              <TextBlock Text="没有配置 Wi-Fi ADB 设备" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>

    <StackPanel IsVisible="{Binding !IsForward}"
                Spacing="{DynamicResource MptSpacingL}"
                MaxWidth="1480"
                HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="MptPageTitle" Text="ADB Forwarder" />
        <TextBlock Classes="MptPageSubtitle" Text="设置与诊断" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource MptSpacingS}"
                  VerticalAlignment="Center">
        <controls:MptButton Content="返回设备状态" Command="{Binding ShowForwardCommand}" />
        <controls:MptButton Content="设置"
                            Command="{Binding ShowSettingsCommand}"
                            Classes.MptPrimaryButton="{Binding IsSettings}" />
        <controls:MptButton Content="诊断"
                            Command="{Binding ShowDiagnosticsCommand}"
                            Classes.MptPrimaryButton="{Binding IsDiagnostics}" />
        <controls:MptButton Content="刷新" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel IsVisible="False"
                Spacing="{DynamicResource MptSpacingL}">
      <Border Classes="MptInset" IsVisible="{Binding HasConfigurationError}">
        <StackPanel Spacing="4">
          <TextBlock Text="设备配置读取失败" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ConfigurationError}" Classes="MptMeta" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfigurationPath}" Classes="MptMono" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid x:Name="ForwardWorkspaceGrid"
            ColumnDefinitions="*"
            ColumnSpacing="{DynamicResource MptSpacingL}">
        <StackPanel x:Name="ForwardSetupColumn"
                    Spacing="{DynamicResource MptSpacingL}">
          <Border Classes="MptCard">
            <StackPanel Spacing="{DynamicResource MptSpacingL}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Classes="MptSectionTitle" Text="选择要共享的设备" />
                  <TextBlock Classes="MptPageSubtitle"
                             Text="设备连接并完成 USB 调试授权后，会显示在这里。"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Classes="MptStatusBadge"
                        Classes.running="{Binding ForwardIsReady}"
                        Classes.degraded="{Binding IsForwardBusy}"
                        Classes.error="{Binding ForwardNeedsAttention}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding ForwardStatusLabel}" Classes="MptMeta" />
                </Border>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource MptSpacingM}">
                <Button Classes="connection-mode"
                        Classes.selected="{Binding IsWiredForward}"
                        Command="{Binding SelectWiredForwardCommand}"
                        AutomationProperties.Name="使用 USB 连接">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Text="&#xE88E;"
                               FontFamily="{DynamicResource MptFontFamilyIcons}"
                               FontSize="22"
                               Foreground="{DynamicResource MptBrushAccent}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="USB 连接" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding WiredDeviceCount, StringFormat='检测到 {0} 台'}"
                                 Classes="MptMeta" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Grid.Column="1"
                        Classes="connection-mode"
                        Classes.selected="{Binding IsWirelessForward}"
                        Command="{Binding SelectWirelessForwardCommand}"
                        AutomationProperties.Name="使用无线 ADB 连接">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Text="&#xE701;"
                               FontFamily="{DynamicResource MptFontFamilyIcons}"
                               FontSize="22"
                               Foreground="{DynamicResource MptBrushAccent}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="无线 ADB" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding WirelessDeviceCount, StringFormat='检测到 {0} 台'}"
                                 Classes="MptMeta" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>

              <StackPanel Spacing="{DynamicResource MptSpacingS}">
                <TextBlock Text="ADB 设备" Classes="MptMeta" />
                <controls:MptComboBox ItemsSource="{Binding ForwardDevices}"
                                      SelectedItem="{Binding SelectedForwardDevice, Mode=TwoWay}"
                                      MinHeight="38"
                                      MaxDropDownHeight="360"
                                      HorizontalAlignment="Stretch">
                  <controls:MptComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:AdbForwarderDevice">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="{DynamicResource MptSpacingM}"
                            MinHeight="52"
                            Margin="4,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding IdentityLabel}"
                                     Classes="MptMono"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StateLabel}"
                                   Classes="MptMeta"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </controls:MptComboBox.ItemTemplate>
                </controls:MptComboBox>
                <TextBlock Text="没有检测到 ADB 设备。连接设备并确认 USB 调试授权后点击刷新。"
                           IsVisible="{Binding !HasForwardDevices}"
                           Foreground="{DynamicResource MptBrushWarning}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Expander Header="高级端口设置">
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="{DynamicResource MptSpacingM}"
                      Margin="0,12,0,0">
                  <StackPanel Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock Text="内部转发端口" Classes="MptMeta" />
                    <NumericUpDown Value="{Binding LocalForwardPort, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock Text="局域网共享端口" Classes="MptMeta" />
                    <NumericUpDown Value="{Binding SharedPort, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock Text="Android ADB 端口" Classes="MptMeta" />
                    <NumericUpDown Value="{Binding DevicePort, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" FormatString="0" />
                  </StackPanel>
                </Grid>
              </Expander>

              <Expander Header="远端 AOSP 主机">
                <StackPanel Spacing="{DynamicResource MptSpacingM}" Margin="0,12,0,0">
                  <controls:MptCheckBox Content="同时共享给远端主机"
                                        IsChecked="{Binding IncludeSsh, Mode=TwoWay}" />
                  <Grid IsVisible="{Binding IncludeSsh}"
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="130,*"
                        RowSpacing="{DynamicResource MptSpacingS}"
                        ColumnSpacing="{DynamicResource MptSpacingM}">
                    <TextBlock Text="远端主机" VerticalAlignment="Center" />
                    <controls:MptTextBox Grid.Column="1"
                                         Text="{Binding RemoteHost, Mode=TwoWay}"
                                         PlaceholderText="r743" />
                    <TextBlock Grid.Row="1" Text="远端 ADB 路径" VerticalAlignment="Center" />
                    <controls:MptTextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RemoteAdbPath, Mode=TwoWay}"
                                         PlaceholderText="/android/aosp/out/soong/host/linux-x86/bin/adb" />
                  </Grid>
                </StackPanel>
              </Expander>

              <Border Classes="MptInset"
                      IsVisible="{Binding !BrokerAvailable}">
                <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Text="端口更改暂不可用"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BrokerAvailabilityMessage}"
                             Classes="MptMeta"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <WrapPanel Orientation="Horizontal">
                <controls:MptButton Classes="MptPrimaryButton"
                                    Content="开始共享"
                                    Margin="{DynamicResource MptWrapItemMargin}"
                                    Command="{Binding StartForwardCommand}" />
                <controls:MptButton Content="检查连接"
                                    Margin="{DynamicResource MptWrapItemMargin}"
                                    Command="{Binding PreflightForwardCommand}" />
                <controls:MptButton Content="取消"
                                    IsVisible="{Binding IsForwardBusy}"
                                    Margin="{DynamicResource MptWrapItemMargin}"
                                    Command="{Binding CancelForwardCommand}" />
                <controls:MptButton Content="{Binding RetryForwardLabel}"
                                    IsVisible="{Binding CanRetryForward}"
                                    Margin="{DynamicResource MptWrapItemMargin}"
                                    Command="{Binding RetryForwardCommand}" />
                <controls:MptButton Content="清理资源"
                                    IsVisible="{Binding CanCleanupForward}"
                                    Margin="{DynamicResource MptGapBottomS}"
                                    Command="{Binding CleanupForwardCommand}" />
              </WrapPanel>

              <Border Classes="MptInset">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                    <TextBlock Text="{Binding ForwardActionMessage}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ForwardConnectionHint}"
                               Classes="MptMeta"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              IsVisible="{Binding ForwardIsReady}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <TextBlock Text="在另一台电脑运行" Classes="MptMeta" HorizontalAlignment="Right" />
                    <SelectableTextBlock Text="{Binding ForwardConnectCommand}"
                                         Classes="MptMono"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="MptCard" IsVisible="{Binding HasPreflightChecks}">
            <StackPanel Spacing="{DynamicResource MptSpacingM}">
              <TextBlock Classes="MptSectionTitle" Text="预检结果" />
              <ItemsControl ItemsSource="{Binding PreflightChecks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdbForwarderPreflightCheckViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{DynamicResource MptSpacingM}"
                          Margin="{DynamicResource MptGapBottomXs}">
                      <Border Width="8" Height="8" CornerRadius="4"
                              Background="{DynamicResource MptBrushNeutral}"
                              Classes.running="{Binding IsPassed}"
                              Classes.error="{Binding IsFailed}"
                              VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingXs}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}"
                                   Classes="MptMeta"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="2"
                              Classes="MptStatusBadge"
                              Classes.running="{Binding IsPassed}"
                              Classes.degraded="{Binding IsWarning}"
                              Classes.error="{Binding IsFailed}">
                        <TextBlock Text="{Binding StateLabel}" Classes="MptMeta" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="预检尚未运行。这里仅执行 adb、netsh、端口与可选 SSH 的只读检查。"
                         IsVisible="{Binding !HasPreflightChecks}"
                         Classes="MptPageSubtitle"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="ForwardProgressColumn"
                     Grid.Column="1"
                    IsVisible="{Binding HasForwardRun}"
                    Spacing="{DynamicResource MptSpacingL}">
          <Border Classes="MptCard">
            <StackPanel Spacing="{DynamicResource MptSpacingM}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Classes="MptSectionTitle" Text="执行详情" />
                  <TextBlock Classes="MptPageSubtitle"
                             Text="这里显示检查、授权和连接结果。" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Width="110"
                             Height="4"
                             IsIndeterminate="{Binding IsForwardBusy}"
                             VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ForwardSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdbForwarderWorkflowStepViewModel">
                    <Grid ColumnDefinitions="24,*,Auto"
                          ColumnSpacing="{DynamicResource MptSpacingM}"
                          Margin="{DynamicResource MptGapBottomXs}">
                      <Border Width="20" Height="20" CornerRadius="10"
                              Background="{DynamicResource MptBrushSurfaceMuted}"
                              BorderBrush="{DynamicResource MptBrushDivider}"
                              BorderThickness="1">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="{DynamicResource MptFontFamilyIcons}"
                                   FontSize="{DynamicResource MptFontSizeCaption}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingXs}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}"
                                   Classes="MptMeta"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="2"
                              Classes="MptStatusBadge"
                              Classes.running="{Binding IsSucceeded}"
                              Classes.degraded="{Binding IsWarning}"
                              Classes.error="{Binding IsFailed}">
                        <TextBlock Text="{Binding StateLabel}" Classes="MptMeta" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="MptCard" IsVisible="{Binding HasForwardLogs}">
            <StackPanel Spacing="{DynamicResource MptSpacingM}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="MptSectionTitle" Text="操作记录" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="最多保留 200 条" />
              </Grid>
              <Border Classes="MptInset" MinHeight="150" MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ForwardLogs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AdbForwarderWorkflowLogViewModel">
                        <Grid ColumnDefinitions="64,110,*"
                              ColumnSpacing="{DynamicResource MptSpacingS}"
                              Margin="{DynamicResource MptGapBottomXs}">
                          <TextBlock Text="{Binding Time}" Classes="MptMono" />
                          <TextBlock Grid.Column="1" Text="{Binding Step}" Classes="MptMeta" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Message}"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsSettings}"
                Spacing="{DynamicResource MptSpacingL}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="MptSectionTitle" Text="ADB 环境与设备设置" />
          <TextBlock Classes="MptMeta"
                     Text="这些值直接驱动设备扫描、后台有线转发和 Wi-Fi ADB 恢复。"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="MptStatusBadge" VerticalAlignment="Center">
          <TextBlock Text="{Binding EnvironmentStateLabel}" Classes="MptMeta" />
        </Border>
      </Grid>

      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingM}">
          <TextBlock Classes="MptSectionTitle" Text="运行环境" />
          <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="{DynamicResource MptSpacingL}">
            <StackPanel Spacing="6">
              <TextBlock Text="ADB 可执行文件" FontWeight="SemiBold" />
              <controls:MptTextBox Text="{Binding AdbExecutablePath, Mode=TwoWay}"
                                   PlaceholderText="adb 或 adb.exe 的完整路径"
                                   AutomationProperties.Name="ADB 可执行文件路径" />
              <TextBlock Classes="MptMeta"
                         Text="可填写 PATH 中的命令名，也可填写 Android platform-tools 中 adb.exe 的完整路径。"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="设备配置文件" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConfigurationPath}"
                         Classes="MptMono"
                         TextWrapping="Wrap" />
              <TextBlock Classes="MptMeta"
                         Text="保存时会校验全部设备，并以 UTF-8 原子更新 devices.ini。"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="WakeupPad 设备 ID（可选）" FontWeight="SemiBold" />
            <controls:MptTextBox Text="{Binding WakeupPadDeviceId, Mode=TwoWay}"
                                 PlaceholderText="用于唤醒面板的 ADB 设备 ID"
                                 AutomationProperties.Name="WakeupPad 设备 ID" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingM}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="MptSectionTitle" Text="有线设备转发" />
              <TextBlock Classes="MptMeta"
                         Text="为每台 USB ADB 设备分配固定共享端口；内部 ADB 端口自动使用共享端口 + 15000。"
                         TextWrapping="Wrap" />
            </StackPanel>
            <controls:MptButton Grid.Column="1"
                                Content="添加有线设备"
                                Command="{Binding AddConfiguredForwardDeviceCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ConfiguredForwardDeviceEditors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdbForwardDeviceSettingEditorViewModel">
                <Border Classes="MptInset" Margin="{DynamicResource MptGapBottomXs}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="设备 ID" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding DeviceId, Mode=TwoWay}"
                                             PlaceholderText="USB ADB 序列号"
                                             AutomationProperties.Name="有线设备 ID" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="共享端口" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding Port, Mode=TwoWay}"
                                             PlaceholderText="15555"
                                             AutomationProperties.Name="有线设备共享端口" />
                      </StackPanel>
                      <controls:MptButton Grid.Column="2"
                                          Content="移除"
                                          Command="{Binding RemoveCommand}"
                                          VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource MptBrushDanger}"
                               IsVisible="{Binding HasValidationError}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="MptEmptyState" IsVisible="{Binding !HasConfiguredForwardDeviceEditors}">
            <TextBlock Text="还没有有线设备配置。添加设备后填写 ADB 设备 ID 与共享端口。"
                       Classes="MptMeta"
                       HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingM}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="MptSectionTitle" Text="无线设备转发" />
              <TextBlock Classes="MptMeta"
                         Text="定时探测无线 ADB；失联时通过配对的 USB 设备恢复 adb tcp。"
                         TextWrapping="Wrap" />
            </StackPanel>
            <controls:MptButton Grid.Column="1"
                                Content="添加无线设备"
                                Command="{Binding AddConfiguredWifiDeviceCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ConfiguredWifiDeviceEditors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdbWifiDeviceSettingEditorViewModel">
                <Border Classes="MptInset" Margin="{DynamicResource MptGapBottomXs}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <controls:MptCheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                            Content="启用"
                                            AutomationProperties.Name="启用无线设备" />
                      <controls:MptTextBox Grid.Column="1"
                                           Text="{Binding Name, Mode=TwoWay}"
                                           PlaceholderText="设备名称"
                                           AutomationProperties.Name="无线设备名称" />
                      <controls:MptButton Grid.Column="2"
                                          Content="移除"
                                          Command="{Binding RemoveCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="1.2*,1.2*,140,170" ColumnSpacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="恢复用 USB 序列号" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding UsbSerial, Mode=TwoWay}"
                                             PlaceholderText="USB ADB 序列号"
                                             AutomationProperties.Name="无线设备恢复 USB 序列号" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="主机或 IP" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding Host, Mode=TwoWay}"
                                             PlaceholderText="10.33.0.243"
                                             AutomationProperties.Name="无线设备主机" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="ADB 端口" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding Port, Mode=TwoWay}"
                                             PlaceholderText="5555"
                                             AutomationProperties.Name="无线设备端口" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Text="检查间隔（秒）" Classes="MptMeta" />
                        <controls:MptTextBox Text="{Binding IntervalSeconds, Mode=TwoWay}"
                                             PlaceholderText="60"
                                             AutomationProperties.Name="无线设备检查间隔" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource MptBrushDanger}"
                               IsVisible="{Binding HasValidationError}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="MptEmptyState" IsVisible="{Binding !HasConfiguredWifiDeviceEditors}">
            <TextBlock Text="还没有无线设备配置。添加设备后填写无线端点与恢复用 USB 序列号。"
                       Classes="MptMeta"
                       HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="MptInset">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding EnvironmentStateLabel}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EnvironmentMessage}" Classes="MptMeta" TextWrapping="Wrap" />
          </StackPanel>
          <controls:MptButton Grid.Column="1"
                              Classes="MptPrimaryButton"
                              Content="保存设备设置"
                              Command="{Binding SaveEnvironmentCommand}"
                              VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsRules}"
                Spacing="{DynamicResource MptSpacingL}">
      <Grid x:Name="RulesOverviewGrid"
            ColumnDefinitions="1.15*,0.85*"
            ColumnSpacing="{DynamicResource MptSpacingL}">
        <Border x:Name="CurrentRulesCard"
                Classes="MptCard"
                VerticalAlignment="Top">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                <TextBlock Classes="MptSectionTitle" Text="已启用的共享端口" />
                <TextBlock Classes="MptPageSubtitle"
                           Text="这里只显示用户需要使用的端口；内部桥接细节位于诊断页" />
              </StackPanel>
              <Border Grid.Column="1"
                      Classes="MptStatusBadge"
                      Classes.running="{Binding PortProxyAvailable}"
                      Classes.error="{Binding !PortProxyAvailable}">
                <TextBlock Classes="MptMeta" Text="{Binding PortProxyStateLabel}" />
              </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding ActiveSharedDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:AdbConfiguredForwardDevice">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="{DynamicResource MptSpacingM}"
                        Margin="{DynamicResource MptGapBottomXs}">
                    <Border Classes="MptStatusBadge running" VerticalAlignment="Center">
                      <TextBlock Text="已启用" Classes="MptMeta" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding SharedPortLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DeviceId}" Classes="MptMeta" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ForwardingLabel}" Classes="MptMeta" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="当前没有已启用的 ADB 共享端口。"
                       Classes="MptPageSubtitle"
                       IsVisible="{Binding !HasActiveSharedDevices}" />
            <controls:MptButton Content="导入当前规则"
                                Command="{Binding ImportCurrentRulesCommand}"
                                HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border x:Name="ChangePreviewCard"
                Grid.Column="1"
                Classes="MptCard"
                VerticalAlignment="Top">
          <StackPanel Spacing="{DynamicResource MptSpacingM}">
            <TextBlock Classes="MptSectionTitle" Text="更改预览" />
            <TextBlock Classes="MptCardTitle" Text="{Binding PlanSummary}" />
            <Border Classes="MptInset"
                    IsVisible="{Binding !PortProxyAvailable}">
              <StackPanel Spacing="{DynamicResource MptSpacingS}">
                <TextBlock Text="Windows 端口转发状态当前不可用。刷新后仍未恢复时，请查看诊断信息。"
                           TextWrapping="Wrap" />
                <controls:MptButton Content="查看诊断"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ShowDiagnosticsCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="MptInset"
                    IsVisible="{Binding !BrokerAvailable}">
              <StackPanel Spacing="{DynamicResource MptSpacingS}">
                <TextBlock Text="端口更改暂不可用"
                           Classes="MptCardTitle" />
                <TextBlock Text="{Binding BrokerAvailabilityMessage}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding UserFacingWarnings}"
                          IsVisible="{Binding HasWarnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="18,*" Margin="{DynamicResource MptGapBottomXs}">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{DynamicResource MptFontFamilyIcons}"
                               Foreground="{DynamicResource MptBrushWarning}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Orientation="Horizontal">
              <controls:MptButton Content="重新预览"
                                  Margin="{DynamicResource MptWrapItemMargin}"
                                  Command="{Binding PreviewChangesCommand}" />
              <controls:MptButton Classes="MptPrimaryButton"
                                  Content="应用更改"
                                  Margin="{DynamicResource MptWrapItemMargin}"
                                  Command="{Binding ApplyCommand}" />
              <controls:MptButton Content="移除已保存规则"
                                  Margin="{DynamicResource MptGapBottomS}"
                                  Command="{Binding RevertCommand}" />
            </WrapPanel>
            <TextBlock Classes="MptMeta"
                       Text="应用和还原会创建五分钟有效的一次性审批，并通过 Windows UAC 启动审计 Broker。"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingM}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptSectionTitle" Text="已管理的映射" />
              <TextBlock Classes="MptPageSubtitle"
                         Text="在这里维护期望配置，并与 Windows 当前状态进行比较" />
            </StackPanel>
            <controls:MptButton Grid.Column="1"
                                Content="添加映射"
                                Command="{Binding AddMappingCommand}" />
            <controls:MptButton Grid.Column="2"
                                Classes="MptPrimaryButton"
                                Content="保存映射"
                                Command="{Binding SaveMappingsCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Mappings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdbForwarderMappingEditorViewModel">
                <Border Padding="{DynamicResource MptCompactPadding}"
                        Margin="{DynamicResource MptGapBottomXs}"
                        CornerRadius="7"
                        BorderBrush="{DynamicResource MptBrushDivider}"
                        BorderThickness="1"
                        Background="{DynamicResource MptBrushSurfaceMuted}">
                  <StackPanel Spacing="{DynamicResource MptSpacingM}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
                      <controls:MptCheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                            AutomationProperties.Name="启用此映射"
                                            Content="启用" />
                      <controls:MptTextBox Grid.Column="1"
                                           AutomationProperties.Name="映射名称"
                                           Text="{Binding Name, Mode=TwoWay}"
                                           PlaceholderText="映射名称" />
                      <controls:MptButton Grid.Column="2"
                                          Content="移除"
                                          Command="{Binding RemoveCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{DynamicResource MptSpacingS}">
                      <TextBlock Text="共享端口"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource MptBrushTextSecondary}" />
                      <controls:MptTextBox Grid.Column="1"
                                           AutomationProperties.Name="共享端口"
                                           Text="{Binding SharedPort, Mode=TwoWay}"
                                           PlaceholderText="例如 15555" />
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource MptBrushDanger}"
                               IsVisible="{Binding HasValidationError}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="MptEmptyState"
                  IsVisible="{Binding !HasMappings}">
            <StackPanel Spacing="{DynamicResource MptSpacingM}"
                        HorizontalAlignment="Center">
              <TextBlock Text="还没有已管理的映射"
                         Classes="MptCardTitle"
                         HorizontalAlignment="Center" />
              <TextBlock Text="导入当前 Windows 规则，或手动创建第一条映射。"
                         Classes="MptPageSubtitle"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center" />
              <WrapPanel Orientation="Horizontal"
                         HorizontalAlignment="Center">
                <controls:MptButton Content="导入当前规则"
                                    Margin="{DynamicResource MptGapRightM}"
                                    Command="{Binding ImportCurrentRulesCommand}"
                                    IsEnabled="{Binding HasCurrentRules}" />
                <controls:MptButton Content="添加映射"
                                    Classes="MptPrimaryButton"
                                    Command="{Binding AddMappingCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="MptMeta"
                     Text="{Binding ActionMessage}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsDevices}" Spacing="{DynamicResource MptSpacingM}">
      <TextBlock Classes="MptSectionTitle" Text="已连接的 Android 设备" />
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:AdbForwarderDevice">
            <Border Classes="MptCard" Margin="{DynamicResource MptGapBottomXs}">
              <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
                <Border Width="38" Height="38" CornerRadius="8"
                        Background="{DynamicResource MptBrushSurfaceMuted}">
                  <TextBlock Text="&#xE8EA;"
                             FontFamily="{DynamicResource MptFontFamilyIcons}"
                             FontSize="{DynamicResource MptFontSizeCardTitle}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Classes="MptCardTitle" Text="{Binding Model}" />
                  <TextBlock Classes="MptMono" Text="{Binding DisplayId}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="{DynamicResource MptSpacingXs}" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding State}" HorizontalAlignment="Right" />
                  <TextBlock Classes="MptMeta" Text="{Binding Product}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="MptEmptyState" IsVisible="{Binding !HasDevices}">
        <StackPanel Spacing="{DynamicResource MptSpacingS}" HorizontalAlignment="Center">
          <TextBlock Text="没有检测到已授权的 ADB 设备"
                     Classes="MptCardTitle"
                     HorizontalAlignment="Center" />
          <TextBlock Text="连接设备并确认 USB 调试授权后，再点击刷新。"
                     Classes="MptPageSubtitle"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsActivity}" Spacing="{DynamicResource MptSpacingM}">
      <TextBlock Classes="MptSectionTitle" Text="最近的转发活动" />
      <ItemsControl ItemsSource="{Binding Activity}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:AdbForwarderActivity">
            <Grid ColumnDefinitions="72,80,*" Margin="{DynamicResource MptGapBottomXs}">
              <TextBlock Classes="MptMono" Text="{Binding TimeText}" />
              <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding Level}" />
              <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="MptEmptyState" IsVisible="{Binding !HasActivity}">
        <TextBlock Text="近期没有转发活动。" HorizontalAlignment="Center" />
      </Border>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsDiagnostics}" Spacing="{DynamicResource MptSpacingM}">
      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingS}">
          <TextBlock Classes="MptSectionTitle" Text="ADB 运行状态" />
          <TextBlock Classes="MptCardTitle" Text="{Binding AdbStateLabel}" />
          <TextBlock Classes="MptMono" Text="{Binding Snapshot.AdbVersion}" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="设备标识符会在显示前自动脱敏。" />
        </StackPanel>
      </Border>
      <Border Classes="MptCard">
        <StackPanel Spacing="{DynamicResource MptSpacingS}">
          <TextBlock Classes="MptSectionTitle" Text="Windows 端口转发" />
          <TextBlock Classes="MptCardTitle" Text="{Binding PortProxyStateLabel}" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="每次更改都会请求管理员确认，并准备可还原步骤。" />
        </StackPanel>
      </Border>
      <Border Classes="MptCard"
              IsVisible="{Binding HasTechnicalDetails}">
        <StackPanel Spacing="{DynamicResource MptSpacingS}">
          <TextBlock Classes="MptSectionTitle" Text="最近一次错误" />
          <TextBlock Classes="MptMono"
                     Text="{Binding TechnicalDetails}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
