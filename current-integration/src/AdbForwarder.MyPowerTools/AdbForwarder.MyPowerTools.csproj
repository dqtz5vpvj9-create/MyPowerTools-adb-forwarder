<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModulePackageRoot>$(MSBuildProjectDirectory)\..\..\modules\adb-forwarder</ModulePackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Protocol" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Platform.Abstractions" Version="0.2.1" />
  </ItemGroup>

  <Target Name="CopyModuleAssemblyToPackage" AfterTargets="Build">
    <ItemGroup>
      <ModuleDependencyFiles Include="$(TargetDir)MyPowerTools.Platform.Abstractions.dll"
                             Condition="Exists('$(TargetDir)MyPowerTools.Platform.Abstractions.dll')" />
      <ModuleDependencyFiles Include="$(TargetDir)MyPowerTools.Platform.Abstractions.pdb"
                             Condition="Exists('$(TargetDir)MyPowerTools.Platform.Abstractions.pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModulePackageRoot)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(ModuleDependencyFiles)" DestinationFolder="$(ModulePackageRoot)" SkipUnchangedFiles="true" />
  </Target>

</Project>
