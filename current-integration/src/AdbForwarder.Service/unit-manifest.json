{
  "id": "adb-forwarder.service",
  "toolId": "adb-forwarder",
  "displayName": "ADB Forwarder Service",
  "exec": "AdbForwarder.Service.exe",
  "arguments": [
    "--pipe",
    "adb-forwarder.core",
    "--heartbeat-file",
    "%LOCALAPPDATA%/MyPowerTools/state/adb-forwarder.service.heartbeat",
    "--interval-ms",
    "5000"
  ],
  "workingDirectory": "",
  "environment": {
    "MPT_TOOL_DATA_ROOT": "%LOCALAPPDATA%/MyPowerTools/state/tools/adb-forwarder",
    "MPT_ADB_CONFIG_PATH": "%LOCALAPPDATA%/AdbForwarder/devices.ini"
  },
  "autostart": true,
  "restartPolicy": { "maxRestarts": 5, "backoffMs": 2000 },
  "readiness": { "kind": "pipe", "address": "adb-forwarder.core", "timeoutMs": 10000 },
  "stopTimeoutMs": 8000,
  "dataRoots": [
    "%LOCALAPPDATA%/MyPowerTools/state/tools/adb-forwarder",
    "%LOCALAPPDATA%/AdbForwarder"
  ],
  "dependsOn": [],
  "instanceToken": "adb-forwarder-service-v1"
}
